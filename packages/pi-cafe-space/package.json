{
  "name": "@cafecodework/pi-cafe-space",
  "version": "0.1.0",
  "private": true,
  "description": "Share live Pi CLI sessions with authenticated Web/PWA clients without terminal mirroring.",
  "license": "MIT",
  "author": "cafecodework",
  "type": "module",
  "files": [
    "dist",
    "scripts",
    ".env.example",
    "README.md",
    "LICENSE",
    "docs"
  ],
  "keywords": [
    "pi-package"
  ],
  "pi": {
    "extensions": [
      "./dist/extension/index.js"
    ]
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.json && node -e \"require('node:fs').cpSync('web/public','dist/relay/public',{recursive:true})\"",
    "prepack": "npm run build",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src --exclude web/**",
    "refactor:contracts:test": "vitest run src/protocol/fixtures.test.ts",
    "refactor:web:check": "tsc -p web/tsconfig.json --noEmit",
    "refactor:web:test": "vitest run --config web/vitest.config.ts",
    "refactor:web:build": "vite build --config web/vite.config.ts",
    "relay": "node dist/relay/index.js",
    "relay:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-relay.ps1",
    "relay:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-relay.ps1",
    "pi:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-pi.ps1"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.18",
    "@assistant-ui/react-markdown": "0.14.14",
    "axios": "1.18.0",
    "clsx": "2.1.1",
    "i18next": "25.8.13",
    "immer": "11.1.4",
    "lodash-es": "4.18.1",
    "modern-normalize": "3.0.1",
    "nanoid": "5.1.16",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-i18next": "16.5.4",
    "react-router": "7.18.2",
    "use-immer": "0.11.0",
    "ws": "8.21.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@testing-library/dom": "10.4.1",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/lodash-es": "4.17.12",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1",
    "@vitejs/plugin-react": "4.7.0",
    "jsdom": "26.1.0",
    "sass": "1.97.3",
    "vite": "6.4.3",
    "vitest": "4.1.11"
  }
}
